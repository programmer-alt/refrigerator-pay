# Server Port
PORT=5000

# Database — SQLite by default, change to PostgreSQL for production
DATABASE_URL="file:./dev.db"

# Frontend URL for CORS
CLIENT_URL="http://localhost:5173"

# Payment Mode: "mock" (local emulator) or "yookassa" (real bank)
PAYMENT_MODE=mock

# YooKassa credentials (test mode)
YOOKASSA_SHOP_ID="your_test_shop_id"
YOOKASSA_SECRET_KEY="test_..."
