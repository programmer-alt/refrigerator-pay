# Server Port
PORT=5000

# Frontend URL for CORS
CLIENT_URL="http://localhost:5173"

# Payment Mode: "mock" (local emulator) or "yookassa" (real bank)
PAYMENT_MODE=mock

# YooKassa credentials (test mode)
# ⚠️ Заполните при переключении на PAYMENT_MODE=yookassa
# Получить ключи: https://yookassa.ru/developers/api
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
